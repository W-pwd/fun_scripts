async function waitWebFroms(page) {
	return await Promise.all([page.waitForFunction(() => {
		return typeof Sys === 'undefined' || !Sys.WebForms || !Sys.WebForms.PageRequestManager || !Sys.WebForms.PageRequestManager.getInstance().get_isInAsyncPostBack();
	}), page.waitForFunction(() => document.readyState === 'interactive' || document.readyState === 'complete')]);
}
async function openOrdersTab(page, tabText) {
	const retryMS = 2000;
	const iframeSelector = '#ctl00_ContentPlaceHolder1_BootstrapFormLayout_ShowProcess_Dr_Page_Process_iframe_Orders';
	const iframeHandle = await page.locator(iframeSelector).elementHandle();
	let frame = await iframeHandle.contentFrame();
	const frameAttachStart = Date.now();
	while (!frame) {
		if (Date.now() - frameAttachStart > retryMS) {
			console.log(`Orders iframe element exists but its content frame never been attached for ${tabText}`);
		}
		frame = await iframeHandle.contentFrame();
	}
	console.log(`${tabText} Waiting for DOMcontentLoaded event`);
	await frame.waitForLoadState('domcontentloaded');
	const deadline = Date.now() + retryMS;
	while (true) {
		try {
			const tab = frame.locator('a.nav-link:not(.active)').filter({
				hasText: tabText
			}).first();
			let Tab_isVisible = await tab.isVisible();
			console.log(`${tabText} TAB is ${Tab_isVisible ? 'found' : 'not found'}`);
			if (Tab_isVisible) await tab.click();
			const activeTab = frame.locator('a.nav-link.active').filter({
				hasText: tabText
			}).first();
			let activeTab_isVisible = await activeTab.isVisible();
			console.log(`${tabText} TAB is ${activeTab_isVisible ? 'is ACTIVE' : 'ACTIVATION FAILED'}`);
			console.log(`${tabText} Waiting for activeTab to be visible event`);
			await activeTab.waitFor({
				state: 'visible',
				timeout: 100
			});
			break;
		} catch (e) {
			if (Date.now() > deadline) {
				console.log(`Clicking "${tabText}" FAILED ${e}`);
			}
		}
	}
	return frame;
}
async function ComboBoxChoose(page, id) {
	const retryMS = 1000;
	const deadline = Date.now() + retryMS;
	while (true) {
		try {
			let combo = page.locator(id);
			let ComboBox_isVisible = await combo.isVisible();
			if (ComboBox_isVisible) 
				throw new Error(`${page.name} ComboBox is not visible`);
			await combo.locator('.dropdown-toggle').click();
			const items = page.locator(`${id}_L li:not([data-type])`);
			const count = await items.count();
			console.log(`${id} items in the ComboBox are ${count}`)
			const randomIndex = Math.floor(Math.random() * count);
			await items.nth(randomIndex).click();
			break;
		} catch (e) {
			if (Date.now() > deadline) {
				console.log(`${page.name} ComboBox clicking FAILED ${e}`);
			}
		}
	}
}

async function getRowLocator(page, index) {
	const primary = page.locator(GRID_ROW_SELECTOR_PREFIX).nth(index);
	const fallback = page.locator(GRID_ROW_FALLBACK).nth(index);
	const deadline = Date.now() + 10000;
	while (Date.now() < deadline) {
		try {
			await primary.waitFor({
				state: 'visible',
				timeout: 100
			});
			let isvisible = await primary.isVisible()
			if (!isvisible) {
				let fallback_visible = await fallback.waitFor({
					state: 'visible',
					timeout: 100
				});
				if (fallback_visible) return fallback;
				throw new Error(`Failed to get rows`);
			} else {
				return primary;
			}
		} catch {
			console.log(`Page Failed getting the row`);
		}
	}
}
async function createPageSession({
