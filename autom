				}
			}));
			pages.forEach(p => waitWebFroms(p));
			await Promise.all(frames.map(async (frame, i) => {
				if (!frame) return;
				while (true) {
					try {
						console.log(`Page${i + 1} clicking the ADD button`);
						await frame.locator(SESSIONS_CONFIG[i].addBtn).click({
							timeout: 100
						});
                        break;
					} catch (e) {
						console.log(`Page${i + 1} failed clicking the ADD button`, e);
					}
				}
			}));
			pages.forEach(p => waitWebFroms(p));
			console.log(`---------------------------------------`);
			while (true) {
				try {
					console.log(`SAVING STARTING TO CLICK SAVE ON ALL`);
					await Promise.all(frames.map((frame, i) => frame ? frame.locator(SESSIONS_CONFIG[i].saveBtn).click() : Promise.resolve()));
					break;
				} catch (e) {
